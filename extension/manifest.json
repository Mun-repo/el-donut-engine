{
  "manifest_version": 3,
  "name": "El Donut Engine",
  "version": "2.1.0",
  "description": "Pink pastel Stockfish assistant for games against chess.com bots. Runs 100% locally.",
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "El Donut Engine",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "guard.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.css",
        "panel.js",
        "i18n.js",
        "engine/*",
        "icons/*",
        "fonts/*"
      ],
      "matches": [
        "https://www.chess.com/*"
      ]
    }
  ]
}
